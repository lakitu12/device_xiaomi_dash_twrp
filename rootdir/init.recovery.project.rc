# Start stock recovery adbd independently of the TWRP UI process.
on post-fs
    # The generic recovery init creates an empty /sdcard mount point on init.
    # Dash uses /data/media/0 directly, so remove that compatibility directory
    # after init has run and publish the real storage path to recovery services.
    export EXTERNAL_STORAGE /data/media/0
    rmdir /sdcard
    setprop sys.usb.config adb

# Run Xiaomi's stock host-touch report loop without the Android Binder HAL.
service dash-touch-bridge /system/bin/touch_report_debug
    class core
    user root
    group root input
    seclabel u:r:recovery:s0
    disabled
    # This is a long-running daemon. If it exits during early touch setup,
    # let init retry it (default 5s period) instead of leaving the screen
    # permanently inert.
    setenv LD_LIBRARY_PATH /odm/lib64:/system/lib64

# Load kernel modules — touchscreen first, then USB storage for OTG.
on init
    insmod /lib/modules/xiaomi_touch_dash.ko
    insmod /lib/modules/nt38771_touch_dash.ko
    # USB mass-storage for OTG support (built-in or module)
    insmod /lib/modules/usb-storage.ko
    insmod /lib/modules/uas.ko

# Module probing and ueventd publish the character node asynchronously, so
# wait for the node before starting the host-touch loop. A wait timeout only
# fails this one command: the start still runs and init's service retry above
# keeps recovering until the node appears.
on boot
    wait /dev/xiaomi-touch 10
    chown root input /dev/xiaomi-touch
    chmod 0660 /dev/xiaomi-touch
    # Set sysfs permissions for haptic feedback (vibration)
    # TWRP writes to timed_output or LED-class vibrator nodes on touch events.
    chown root root /sys/class/timed_output/vibrator/enable
    chmod 0666 /sys/class/timed_output/vibrator/enable
    chown root root /sys/class/leds/vibrator/duration
    chmod 0666 /sys/class/leds/vibrator/duration
    chown root root /sys/class/leds/vibrator/activate
    chmod 0666 /sys/class/leds/vibrator/activate
    start dash-touch-bridge
