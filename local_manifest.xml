<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="yorokobi"
          fetch="https://github.com/YorokobiMaster/" />
  <remote name="lakitu12"
          fetch="https://github.com/lakitu12/" />

  <!-- Replace the three upstream platform repos with the dash-modified forks. -->
  <remove-project name="android_bootable_recovery" />
  <remove-project name="android_system_core" />
  <remove-project name="android_system_vold" />

  <!-- Override external/sqlite to add recovery_available on static noicu variant -->
  <!-- Note: twrp-default.xml already removes platform/external/sqlite and
       adds android_external_sqlite from TWRP-A16 remote. We override that
       with our own fork. -->
  <remove-project name="android_external_sqlite" />

  <project path="bootable/recovery" name="android_bootable_recovery" remote="lakitu12" revision="twrp-16.0" />
  <project path="system/core" name="android_system_core" remote="yorokobi" revision="twrp-16.0" />
  <project path="system/vold" name="android_system_vold" remote="yorokobi" revision="twrp-16.0" />
  <project path="external/sqlite" name="android_external_sqlite" remote="lakitu12" revision="twrp-16.0" />

  <project path="device/xiaomi/dash" name="device_xiaomi_dash_twrp" remote="yorokobi" revision="twrp-16.0" />
  <project path="repack" name="dash_vendor_boot_repack" remote="yorokobi" revision="main" />
</manifest>
