<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="lakitu12"
          fetch="https://github.com/lakitu12/" />

  <!-- 官方源码 + 必要修改路线 (2026-08-05)：
       bootable/recovery 覆盖为 lakitu12 fork：官方基线
       + minuitwrp DRM RGB565 修复 + TW_KEEP_VENDOR/ODM_MOUNTED。
       system/vold 覆盖为 lakitu12 fork：官方基线
       + TWRP-DBG printf（keystore 密钥检索失败点日志，recovery 无 logd）。
       system/core、external/sqlite 用官方默认。 -->

  <remove-project name="android_bootable_recovery" />
  <project path="bootable/recovery" name="android_bootable_recovery" remote="lakitu12" revision="twrp-16.0" />

  <remove-project name="android_system_vold" />
  <project path="system/vold" name="android_system_vold" remote="lakitu12" revision="twrp-16.0" />

  <project path="device/xiaomi/dash" name="device_xiaomi_dash_twrp" remote="lakitu12" revision="twrp-16.0" />
</manifest>
